# syntax=docker/dockerfile:1
# Dockerfile с использованием SWC (очень быстрый и легкий компилятор)
# Требует намного меньше памяти чем TypeScript (< 256 MB)
# Использование: docker build -f Dockerfile.swc .
# Кэш npm (--mount=type=cache) ускоряет повторные сборки; нужен BuildKit (Docker 23+ / compose v2 по умолчанию).
# node_modules ставятся один раз в builder, затем npm prune — без второго npm ci в production
# (на VPS с ~512 MB RAM повторный npm ci легко занимает 5+ минут).

FROM node:18-alpine AS builder

WORKDIR /app

COPY package*.json ./

# Меньше параллелизма и без audit/fund — экономия RAM/CPU на слабых VPS
RUN --mount=type=cache,target=/root/.npm,id=npm-backend \
    npm ci --no-audit --no-fund --maxsockets=3

COPY . .

RUN npm run build:swc \
 && npm prune --omit=dev --no-audit --no-fund

# Production stage: копируем уже собранное, без повторной установки зависимостей
FROM node:18-alpine AS production

WORKDIR /app

COPY package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/src ./src
COPY --from=builder /app/tsconfig.json ./tsconfig.json

# su-exec: entrypoint правит права на bind-mount uploads и сбрасывает привилегии
RUN addgroup -g 1001 -S nodejs \
 && adduser -S nodejs -u 1001 \
 && apk add --no-cache su-exec \
 && mkdir -p /app/uploads/clubs \
 && chown -R nodejs:nodejs /app /app/uploads

COPY docker-entrypoint.sh /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh

# Остаёмся root: entrypoint создаст uploads/clubs на volume и переключится на nodejs
EXPOSE 3001

ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD ["npm", "start"]
