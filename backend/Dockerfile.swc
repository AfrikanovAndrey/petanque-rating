# syntax=docker/dockerfile:1
# Dockerfile с использованием SWC (очень быстрый и легкий компилятор)
# Требует намного меньше памяти чем TypeScript (< 256 MB)
# Использование: docker build -f Dockerfile.swc .
# Кэш npm (--mount=type=cache) ускоряет повторные сборки; нужен BuildKit (Docker 23+ / compose v2 по умолчанию).

FROM node:18-alpine AS builder

# Устанавливаем рабочую директорию
WORKDIR /app

# Копируем package.json и package-lock.json
COPY package*.json ./

# Устанавливаем все зависимости строго по lock-файлу (включая dev для сборки SWC)
RUN --mount=type=cache,target=/root/.npm,id=npm-backend \
    npm ci

# Копируем исходный код и конфигурацию SWC
COPY . .

# Компилируем TypeScript с использованием SWC (быстро и мало памяти)
RUN npm run build:swc

# Production stage
FROM node:18-alpine AS production

# Устанавливаем рабочую директорию
WORKDIR /app

# Копируем package.json и package-lock.json
COPY package*.json ./

# Production-зависимости по lock-файлу (typescript и ts-node уже в dependencies)
RUN --mount=type=cache,target=/root/.npm,id=npm-backend \
    npm ci --omit=dev

# Копируем скомпилированный код из builder stage
COPY --from=builder /app/dist ./dist

# Копируем исходники для миграций (нужны для ts-node)
COPY --from=builder /app/src ./src
COPY --from=builder /app/tsconfig.json ./tsconfig.json

# Создаем пользователя для безопасности
RUN addgroup -g 1001 -S nodejs
RUN adduser -S nodejs -u 1001

# su-exec: entrypoint правит права на bind-mount uploads и сбрасывает привилегии
RUN apk add --no-cache su-exec \
    && mkdir -p /app/uploads/clubs \
    && chown -R nodejs:nodejs /app /app/uploads

COPY docker-entrypoint.sh /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh

# Остаёмся root: entrypoint создаст uploads/clubs на volume и переключится на nodejs
EXPOSE 3001

ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD ["npm", "start"]

